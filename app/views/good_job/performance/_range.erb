<% range_badge_label = performance_range.key || t(".custom_range") %>
<% reload_range_label = t(".reload_range") %>
<%# url_for carries the locale via ApplicationController#default_url_options. %>
<% reload_range_path = url_for(performance_range.reload_params.symbolize_keys) %>
<% custom_range_path = url_for(performance_range.custom_params.symbolize_keys) %>
<% time_zone_label = Time.zone.name %>
<% start_errors = performance_range.errors.messages_for(:chart_start) %>
<% end_errors = performance_range.errors.messages_for(:chart_end) %>
<% base_errors = [:base, :chart_range, :chart_time_zone].flat_map { |attribute| performance_range.errors.messages_for(attribute) } %>
<% range_form_data = {
  controller: "performance-range",
  performance_range_end_timestamp_value: performance_range.canonical_timestamp(performance_range.end_time),
  performance_range_invalid_value: performance_range.invalid?,
  performance_range_start_timestamp_value: performance_range.canonical_timestamp(performance_range.start_time),
} %>

<%= tag.form(
      action: url_for,
      method: "get",
      class: "mb-3",
      aria: { describedby: "performance-range-time-zone", labelledby: "performance-range-name" },
      data: range_form_data
    ) do %>
  <span class="visually-hidden" id="performance-range-name"><%= t ".time_range" %></span>
  <%= hidden_field_tag :locale, params[:locale] if params[:locale] %>
  <%= hidden_field_tag GoodJob::PerformanceRange::TIME_ZONE_PARAMETER_KEY, nil, disabled: true, id: nil, data: { performance_range_target: "timeZoneInput" } %>
  <% if base_errors.any? %>
    <div class="alert alert-danger py-2 mb-2" role="alert"><%= base_errors.to_sentence %></div>
  <% end %>
  <div class="d-flex flex-wrap gap-2">
    <div class="input-group w-auto">
      <span class="input-group-text"><%= render_icon "clock" %></span>
      <%= datetime_local_field_tag "chart_start", performance_range.form_start_value, min: GoodJob::PerformanceRange::MINIMUM_LOCAL_VALUE, max: GoodJob::PerformanceRange::MAXIMUM_LOCAL_VALUE, step: 1, required: true, class: ["form-control", ("is-invalid" if start_errors.any?)], aria: { describedby: "performance-range-time-zone", label: t(".start_time") }, data: { performance_range_target: "startInput", action: "change->performance-range#submitRange click->performance-range#openPicker" } %>
      <% if start_errors.any? %>
        <div class="invalid-feedback"><%= start_errors.to_sentence %></div>
      <% end %>
    </div>
    <div class="input-group w-auto">
      <%= datetime_local_field_tag "chart_end", performance_range.form_end_value, min: GoodJob::PerformanceRange::MINIMUM_LOCAL_VALUE, max: GoodJob::PerformanceRange::MAXIMUM_LOCAL_VALUE, step: 1, required: true, class: ["form-control", ("is-invalid" if end_errors.any?)], aria: { describedby: "performance-range-time-zone", label: t(".end_time") }, data: { performance_range_target: "endInput", action: "change->performance-range#submitRange click->performance-range#openPicker" } %>
      <% if end_errors.any? %>
        <div class="invalid-feedback"><%= end_errors.to_sentence %></div>
      <% end %>
    </div>
    <div class="btn-group">
      <span class="btn btn-outline-secondary performance-range-key"><%= range_badge_label %></span>
      <button class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t ".open_time_ranges" %>">
        <span class="visually-hidden"><%= t ".open_time_ranges" %></span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><h6 class="dropdown-header"><%= t ".quick_ranges" %></h6></li>
        <% performance_range.options.each do |range| %>
          <% active = performance_range.key == range[:key] %>
          <% preset_range_path = url_for(chart_range: range[:key]) %>
          <li>
            <%= link_to preset_range_path, class: ["dropdown-item", "performance-range-menu-item", "d-flex", "align-items-center", "gap-2", ("active" if active)], aria: { current: ("page" if active) } do %>
              <span><%= range[:label] %></span>
              <span class="flex-grow-1"><%= t ".range_options.#{range[:key]}" %></span>
            <% end %>
          </li>
        <% end %>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= link_to custom_range_path, class: ["dropdown-item", "performance-range-menu-item", "d-flex", "align-items-center", "gap-2", "performance-range-custom", ("active" if performance_range.custom?)], aria: { current: ("page" if performance_range.custom?) } do %>
            <span>#</span>
            <span class="flex-grow-1"><%= t ".custom_range" %></span>
            <% if local_assigns[:drag_enabled] %>
              <small class="text-body-secondary text-nowrap"><%= t ".custom_range_hint" %></small>
            <% end %>
          <% end %>
        </li>
      </ul>
    </div>
    <%= link_to reload_range_path, class: %w[btn btn-outline-secondary performance-range-reload flex-shrink-0], aria: { label: reload_range_label }, data: { turbo: false }, title: reload_range_label do %>
      <%= render_icon "arrow_clockwise" %>
      <span class="visually-hidden"><%= reload_range_label %></span>
    <% end %>
  </div>
  <div class="small text-body-secondary mt-2" id="performance-range-time-zone">
    <span><%= t ".time_zone" %></span>
    <span data-performance-range-target="timeZoneLabel"><%= time_zone_label %></span>
    <% if local_assigns[:bucket_size] %>
      <span class="mx-1" aria-hidden="true">·</span>
      <span class="performance-chart-bucket-size"><%= t ".chart_bucket_size", size: bucket_size %></span>
    <% end %>
  </div>
<% end %>
